# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# ── Virtual environment ──────────────────────────────────────────────────────
env/
venv/
.venv/

# ── Original paper repo (cloned separately, see README) ──────────────────────
paper_repo/

# ── Generated CSQ question dataset (regenerated by `python main.py generate`) ─
questions/*.json

# ── Experimental results (regenerated by the pipeline) ───────────────────────
results/
results_methods/
logs/

# ── Computed analysis outputs ────────────────────────────────────────────────
analysis/bootstrap_cis.json
analysis/cis.json

# ── Generated plots / tables ─────────────────────────────────────────────────
plots/
paper/*.pdf

# ── Parent paper PDF (cite by URL; do not redistribute) ──────────────────────
8965_Beyond_Prompt_Induced_Lie.pdf
*.pdf

# Allow LaTeX source figures explicitly if you need them
!paper/*.tex
!paper/*.bib

